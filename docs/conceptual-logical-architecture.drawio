        </mxCell>
        <mxCell id="topic-internal" value="&lt;b&gt;Internal state topics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5e6b64&quot;&gt;configs · offsets · status&lt;br&gt;Compacted. Replication 3.&lt;br&gt;Minimum in-sync replicas 2.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#e0c89a;fontFamily=Helvetica;fontSize=14;fontColor=#1b2420;arcSize=12;" vertex="1" parent="1">
