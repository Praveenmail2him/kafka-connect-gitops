        </mxCell>
        <mxCell id="worker-note" value="Stateless JVM pods. A connector is the logical job. Tasks are the parallel units, spread across workers." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=12;fontColor=#5e6b64;" vertex="1" parent="1">
          <mxGeometry x="324" y="236" width="520" height="32" as="geometry"/>
        </mxCell>

