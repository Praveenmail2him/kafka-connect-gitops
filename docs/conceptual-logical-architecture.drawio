        <mxCell id="subtitle" value="A multi-tenant streaming integration tier. Workers are stateless. Kafka holds both the business records and Connect&#39;s own coordination state." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#5e6b64;" vertex="1" parent="1">
