        </mxCell>
        <mxCell id="task-source" value="&lt;b&gt;Source tasks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5e6b64&quot;&gt;Read committed change&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#b7c9be;fontFamily=Helvetica;fontSize=14;fontColor=#1b2420;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="324" y="312" width="160" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="task-smt" value="&lt;b&gt;SMTs and converters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5e6b64&quot;&gt;Mask, route, normalize.&lt;br&gt;Avro or Protobuf.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#b7c9be;fontFamily=Helvetica;fontSize=14;fontColor=#1b2420;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="312" width="180" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="task-sink" value="&lt;b&gt;Sink tasks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5e6b64&quot;&gt;Idempotent write-out&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#b7c9be;fontFamily=Helvetica;fontSize=14;fontColor=#1b2420;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="756" y="312" width="140" height="88" as="geometry"/>
        </mxCell>

        <mxCell id="connect-foot" value="Workers persist zero local state. Cooperative rebalancing pauses only the tasks that move, so the rest of the pipeline keeps streaming. Credentials resolve at runtime from an external secrets store. Nothing secret is stored in Git." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#5e6b64;" vertex="1" parent="1">
          <mxGeometry x="324" y="430" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="layer-state-call" value="STATE AND COORDINATION" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#5e6b64;" vertex="1" parent="1">
          <mxGeometry x="324" y="510" width="240" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="state-hint" value="Offsets, task config, and status live in Kafka, not on the pod. A restarted worker resumes from the log." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#5e6b64;" vertex="1" parent="1">
          <mxGeometry x="324" y="532" width="400" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="topic-data" value="&lt;b&gt;Data topics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5e6b64&quot;&gt;The business stream.&lt;br&gt;Consumers read from here.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#e0c89a;fontFamily=Helvetica;fontSize=14;fontColor=#1b2420;arcSize=12;" vertex="1" parent="1">
